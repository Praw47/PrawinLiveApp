rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStreamHost(streamId) {
      return signedIn()
        && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid == request.auth.uid;
    }

    match /liveStreams/{streamId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'live'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100;
      allow update: if signedIn()
        && resource.data.hostUid == request.auth.uid
        && request.resource.data.hostUid == resource.data.hostUid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['title', 'status', 'viewerCount']);
      allow delete: if signedIn() && resource.data.hostUid == request.auth.uid;

      match /viewers/{viewerId} {
        allow create: if signedIn()
          && request.resource.data.viewerUid == request.auth.uid
          && get(/databases/$(database)/documents/liveStreams/$(streamId)).data.status == 'live';
        allow read: if signedIn()
          && (resource.data.viewerUid == request.auth.uid || isStreamHost(streamId));
        allow update: if signedIn()
          && ((resource.data.viewerUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['answer', 'viewerCandidates', 'state']))
            || (isStreamHost(streamId)
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['offer', 'hostCandidates', 'state'])));
        allow delete: if signedIn()
          && (resource.data.viewerUid == request.auth.uid || isStreamHost(streamId));
      }

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
      }
    }
  }
}