# React app settings (Firebase web config is safe to expose in the browser bundle).
VITE_API_URL=https://your-api-domain.example/api
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Django Firebase Admin SDK settings. Keep the service account private.
FIREBASE_SERVICE_ACCOUNT_FILE=C:\\secure\\firebase-service-account.json
# Alternatively provide the complete JSON as an environment variable.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account"}
FIREBASE_ADMIN_UIDS=your-firebase-uid